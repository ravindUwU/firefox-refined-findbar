{
	"printWidth": 100,
	"singleQuote": true,
	"proseWrap": "always",
	"endOfLine": "auto",
	"experimentalOperatorPosition": "start",
	"overrides": [
		{
			"files": [".vscode/*.json", "**/tsconfig.json", "**/tsconfig.*.json"],
			"options": {
				"parser": "jsonc"
			}
		},
		{
			"files": ["**/*.yaml"],
			"options": {
				"tabWidth": 4
			}
		}
	]
}
